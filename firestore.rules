rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 全域輔助函式 ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerifiedAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == "pickcher123@gmail.com") ||
        request.auth.token.email == "pickcher123@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower() == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower() == "superadmin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_admin', false) == true
        ))
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- 管理員白名單集合（僅允許本人查詢自己是否為管理員，禁止一般用戶列舉全部管理員名單） ---
    match /admins/{adminId} {
      allow read: if isVerifiedAdmin() || (
        isSignedIn() && (
          adminId == request.auth.uid ||
          (request.auth.token.email != null && (
            adminId == request.auth.token.email.lower() ||
            adminId == request.auth.token.email
          ))
        )
      );
      allow write: if isVerifiedAdmin();
    }

    // --- 預設拒絕所有存取 ---
    match /{document=**} {
      allow read, write: if isVerifiedAdmin();
    }

    // --- 使用者資料管理 (防作弊與資產嚴格保護) ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isVerifiedAdmin();
      allow create: if isOwner(userId) && 
                      incoming().role == "user" && 
                      incoming().get('isAdmin', false) == false &&
                      incoming().get('is_admin', false) == false &&
                      incoming().keys().hasAll(['id', 'points']) &&
                      incoming().get('points', 0) == 0 &&
                      incoming().get('bonusPoints', 0) == 0 &&
                      incoming().get('freeDrawTickets', 0) == 0 &&
                      incoming().get('eventPoolTickets', 0) == 0;
                      
      allow update: if (isOwner(userId) && 
                       incoming().get('role', 'user') == existing().get('role', 'user') && 
                       incoming().get('id', userId) == existing().get('id', userId) &&
                       // 🚨 資產與權限防禦鐵壁：前端用戶絕對不可自行增加鑽石、紅利點數、免費券、活動券或篡改等級／管理員權限
                       !incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'is_admin', 'eventPoolTickets', 'totalSpent', 'userLevel', 'referralCount']) &&
                       (!incoming().diff(existing()).affectedKeys().hasAny(['points']) || incoming().get('points', 0) <= existing().get('points', 0)) &&
                       (!incoming().diff(existing()).affectedKeys().hasAny(['bonusPoints']) || incoming().get('bonusPoints', 0) <= existing().get('bonusPoints', 0)) &&
                       (!incoming().diff(existing()).affectedKeys().hasAny(['freeDrawTickets']) || incoming().get('freeDrawTickets', 0) <= existing().get('freeDrawTickets', 0)) &&
                       // 更名限制：若使用者名稱改變，才檢查限制
                       (incoming().get('username', '') == existing().get('username', '') || (
                         !existing().get('hasChangedUsername', false) && 
                         incoming().hasChangedUsername == true &&
                         incoming().username is string &&
                         incoming().username.size() >= 2 &&
                         incoming().username.size() <= 12
                       ))
                      ) || isVerifiedAdmin();
      
      // 收藏庫卡片子集合：徹底鎖死前端新增與修改（抽卡、拼卡、直購與退單均由後端 Admin SDK 原子寫入），杜絕偽造神卡
      match /userCards/{userCardId} {
        allow read: if isOwner(userId) || isVerifiedAdmin();
        allow create, update: if isVerifiedAdmin();
        allow delete: if isOwner(userId) || isVerifiedAdmin();
      }

      // 其他使用者子集合 (如 poolStats)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isVerifiedAdmin();
      }
    }

    // --- 推薦代碼與紀錄集合 ---
    match /referralCodes/{codeId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /referralPhoneClaims/{phone} {
      allow read, write: if isVerifiedAdmin();
    }

    match /referralLogs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.referrerId == request.auth.uid || resource.data.newUserId == request.auth.uid) || isVerifiedAdmin();
      allow write: if isVerifiedAdmin();
    }

    // --- 卡池管理 (核心防作弊：抽卡扣包與鎖池一律由後端 /api/draw/execute Admin SDK 執行，前端僅允許鎖定者提前解除自己的保護鎖) ---
    match /cardPools/{poolId} {
      allow read: if true; // 所有人可看卡池
      allow update: if isVerifiedAdmin() || (
        isSignedIn() &&
        existing().get('lockedBy', '') == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lockedBy', 'lockedAt']) &&
        incoming().get('lockedBy', null) == null &&
        incoming().get('lockedAt', null) == null
      );
    }

    // --- 系統設定集合 (SMTP 郵件伺服器與後台配置) ---
    match /systemSettings/{settingId} {
      allow read, write: if isVerifiedAdmin();
    }

    // --- 玩家登入紀錄集合 ---
    match /userLoginLogs/{logId} {
      allow read: if isVerifiedAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) || isVerifiedAdmin();
      allow update, delete: if isVerifiedAdmin();
    }

    // --- 行銷郵件紀錄集合 ---
    match /marketingEmailLogs/{logId} {
      allow read, write: if isVerifiedAdmin();
    }

    // --- 卡片主檔集合 (大獎抽出後原子鎖定為已售出，嚴禁竄改名稱/價格/圖片或惡意覆寫他人已售出卡片) ---
    match /allCards/{cardId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin();
      allow update: if isVerifiedAdmin() || (
        isSignedIn() &&
        existing().get('isSold', false) == false &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isSold',
          'isRecycled',
          'status',
          'soldAt',
          'soldBy',
          'soldFromPoolId',
          'soldVia',
          'lockedBy',
          'lockedAt'
        ]) &&
        incoming().get('isSold', false) is bool &&
        (!incoming().diff(existing()).affectedKeys().hasAny(['soldBy']) || incoming().get('soldBy', '') == request.auth.uid)
      );
    }

    // --- 拼卡與命運轉盤兌換獎品集合 ---
    match /redemptionItems/{itemId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /bettingCategories/{catId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /betting-items/{catId} {
      allow read: if true;
      allow create, delete: if isVerifiedAdmin();
      allow update: if isVerifiedAdmin() || (
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['soldCardIds'])
      );
    }

    match /drawCategories/{catId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
    
    match /news/{newsId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /card_exhibitions/{exhId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /lucky_wheels/{wheelId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /group_breaks/{breakId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /group_break_orders/{orderId} {
      allow read: if isVerifiedAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isVerifiedAdmin();
    }

    // --- 福袋集合 ---
    match /luckBags/{bagId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();

      match /luckBagPurchases/{spotId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow update, delete: if isVerifiedAdmin();
      }
    }

    // --- 出貨訂單集合（使用者僅可建立與查詢本人訂單，狀態與物流單號僅限管理員更新） ---
    match /shippingOrders/{orderId} {
      allow read: if isVerifiedAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.get('status', 'pending') == 'pending';
      allow update, delete: if isVerifiedAdmin();
    }

    // --- 其他互動集合 ---
    match /announcements/{id} {
      allow read: if true;
      allow create: if isSignedIn(); // 抽到大獎時系統會建立公告
    }

    match /siteAnnouncements/{id} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
    
    match /predictionEvents/{eventId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /userPredictions/{predictionId} {
      allow read: if true;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isVerifiedAdmin();
    }
    
    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid) || isVerifiedAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow write: if isVerifiedAdmin();
    }

    match /drawnCardLogs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow write: if isVerifiedAdmin();
    }

    match /wishes/{id} {
      allow create: if isSignedIn();
      allow read: if isVerifiedAdmin();
    }

    match /eventTicketDispatches/{dispatchId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid) || isVerifiedAdmin();
      allow write: if isVerifiedAdmin();
    }
  }
}
